# HireSphere AI Environment Configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
USE_MOCK_AI=true
DATABASE_URL=sqlite:///data/database/hiresphere.db
SECRET_KEY=change-this-to-a-very-secret-key-in-production
