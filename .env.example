SMTP_FROM_EMAIL=recruitment@hiresphere.ai
SMTP_FROM_NAME=HireSphere AI Recruitment Team
SMTP_USE_TLS=true
SMTP_MOCK_MODE=true  # Set to false to send real emails via SMTP
